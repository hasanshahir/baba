# ---- Supabase ----
# Canonical server-side names:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project JWT secret (dashboard → Settings → JWT Keys). Only used by the
# dev-only /api/dev-login workaround when the hosted auth service is unusable.
SUPABASE_JWT_SECRET=
# Next.js only exposes NEXT_PUBLIC_* vars to the browser bundle, so the widget
# and auth UI need these mirrors of the two values above (keep them identical):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Anthropic (grounded answer generation) ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override. Haiku = cheap/fast for a support widget; swap to Sonnet for harder docs.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Pinecone (vector store) ----
PINECONE_API_KEY=pc-...
PINECONE_INDEX=guftagu
# "serverless" spec used when auto-creating the index (free tier friendly)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Embeddings ----
# Provider: "pinecone" (default — hosted multilingual-e5-large via your Pinecone
#            key; best Urdu/Roman-Urdu support, no extra account needed),
#           "hf" (Hugging Face Inference API, free tier, same model),
#        or "openai" (text-embedding-3-small, ~$0.02/1M tokens, needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=pinecone
HF_API_TOKEN=hf_...
OPENAI_API_KEY=

# ---- Resend (transcript + escalation emails) ----
RESEND_API_KEY=re_...
# Must be a verified sender/domain in your Resend account
EMAIL_FROM=Guftagu AI <onboarding@resend.dev>

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gates the dev-only /api/test-rag endpoint (any random string)
RAG_TEST_SECRET=change-me
